# Copy this file to .env. Use long random values; passwords must not contain a single quote.
MYSQL_ROOT_PASSWORD=replace_with_a_long_random_root_password
AUTH_DB_PASSWORD=replace_with_a_long_random_auth_password
BOOKING_DB_PASSWORD=replace_with_a_long_random_booking_password
ROOM_DB_PASSWORD=replace_with_a_long_random_room_password
HOUSEKEEPING_DB_PASSWORD=replace_with_a_long_random_housekeeping_password
MAINTENANCE_DB_PASSWORD=replace_with_a_long_random_maintenance_password
NOTIFICATION_DB_PASSWORD=replace_with_a_long_random_notification_password

JWT_SECRET=replace_with_at_least_32_random_bytes_base64_or_hex
REDIS_HOST=redis
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace_with_a_long_random_minio_password

# Spring Boot's relaxed binding reads these directly in every service container.
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092

NGINX_PORT=80
MYSQL_PORT=3306
KAFKA_PORT=9092
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
